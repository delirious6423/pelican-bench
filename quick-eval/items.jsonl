# ---- format: strict instruction following, all machine-checkable
{"id": "format-json-1", "category": "format", "prompt": "Return a JSON object with exactly these keys: \"name\" (string), \"age\" (integer), \"tags\" (array of exactly 3 strings). Output only the JSON, no code fence, no commentary.", "check": {"type": "json_schema", "schema": {"name": "str", "age": "int", "tags": ["str", 3]}}}
{"id": "format-json-2", "category": "format", "prompt": "Produce JSON describing a fictional city with keys \"city\" (string), \"population\" (integer), \"coastal\" (boolean), \"coords\" (object with keys \"lat\" and \"lon\", both numbers). Output only the JSON.", "check": {"type": "json_schema", "schema": {"city": "str", "population": "int", "coastal": "bool", "coords": {"lat": "float", "lon": "float"}}}}
{"id": "format-words-37", "category": "format", "prompt": "Describe a thunderstorm in exactly 37 words. Output only the description.", "check": {"type": "word_count", "expected": 37}}
{"id": "format-words-12", "category": "format", "prompt": "Write a sentence about trains that has exactly 12 words. Output only the sentence.", "check": {"type": "word_count", "expected": 12}}
{"id": "format-no-e", "category": "format", "prompt": "Write two sentences about a sunrise without using the letter e anywhere. Output only the sentences.", "check": {"type": "no_char", "chars": "e"}}
{"id": "format-lower", "category": "format", "prompt": "write three sentences about tea entirely in lowercase letters, including the first letter of each sentence and any names. output only the sentences.", "check": {"type": "lowercase"}}
{"id": "format-wrap", "category": "format", "prompt": "Write a short paragraph about bicycles. It must begin with the exact word \"Indeed\" and end with the exact word \"Done.\" (with the period). Output only the paragraph.", "check": {"type": "regex", "pattern": "Indeed\\b.*\\bDone\\."}}
{"id": "format-numbered-7", "category": "format", "prompt": "List exactly 7 tools found in a kitchen as a numbered list (1. 2. 3. ...), one per line, nothing else.", "check": {"type": "numbered_list", "expected": 7}}
{"id": "format-csv", "category": "format", "prompt": "Output a CSV table with a header row and 4 data rows (5 lines total) and exactly 4 columns: name,country,year,score. No quotes, no commas inside values, no blank lines, nothing except the CSV.", "check": {"type": "csv", "rows": 5, "cols": 4}}
{"id": "format-reverse", "category": "format", "prompt": "Reverse the string quantization character by character. Output only the reversed string.", "check": {"type": "exact", "expected": "noitazitnauq"}}
{"id": "format-count-r", "category": "format", "prompt": "How many times does the letter r appear in the word strawberry? Reply with only the number.", "check": {"type": "last_int", "expected": 3}}
{"id": "format-count-s", "category": "format", "prompt": "How many times does the letter s appear in the word Mississippi? Reply with only the number.", "check": {"type": "last_int", "expected": 4}}
{"id": "format-sort", "category": "format", "prompt": "Sort these words alphabetically and output them comma-separated with a single space after each comma and nothing else: pear, kiwi, apple, mango, fig, banana", "check": {"type": "exact", "expected": "apple, banana, fig, kiwi, mango, pear"}}
{"id": "format-date", "category": "format", "prompt": "What date is the day after 2024-02-28? Reply with only the date in ISO format YYYY-MM-DD.", "check": {"type": "regex", "pattern": "\\s*2024-02-29\\s*"}}
{"id": "format-date-2", "category": "format", "prompt": "What date is 100 days after 2025-12-01? Reply with only the date in ISO format YYYY-MM-DD.", "check": {"type": "regex", "pattern": "\\s*2026-03-11\\s*"}}

# ---- repeat: degeneration / looping under long enumerations
{"id": "repeat-animals-50", "category": "repeat", "prompt": "List 50 distinct animal species, one per line, no numbering, no commentary.", "check": {"type": "unique_lines", "min": 50}}
{"id": "repeat-countries-40", "category": "repeat", "prompt": "List 40 distinct sovereign countries, one per line, no numbering, no commentary.", "check": {"type": "unique_lines", "min": 40}}
{"id": "repeat-words-60", "category": "repeat", "prompt": "List 60 distinct English nouns that start with the letter b, one per line, no numbering, no commentary.", "check": {"type": "unique_lines", "min": 60}}

# ---- tool: function-call fidelity (schemas are passed as the OpenAI tools array)
{"id": "tool-weather", "category": "tool", "prompt": "What's the weather going to be like in Kaohsiung tomorrow? Use Celsius.", "tools": [{"type": "function", "function": {"name": "get_forecast", "description": "Get a weather forecast", "parameters": {"type": "object", "properties": {"city": {"type": "string"}, "day": {"type": "string", "enum": ["today", "tomorrow"]}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]}}, "required": ["city", "day", "unit"]}}}, {"type": "function", "function": {"name": "get_time", "description": "Get the current time in a city", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}}], "check": {"type": "tool_call", "name": "get_forecast", "args": {"city": "Kaohsiung", "day": "tomorrow", "unit": "celsius"}}}
{"id": "tool-transfer", "category": "tool", "prompt": "Move 250 dollars from account ACC-1001 to account ACC-2002 with the memo \"rent\".", "tools": [{"type": "function", "function": {"name": "transfer_funds", "description": "Transfer money between accounts", "parameters": {"type": "object", "properties": {"from_account": {"type": "string"}, "to_account": {"type": "string"}, "amount": {"type": "number"}, "currency": {"type": "string"}, "memo": {"type": "string"}}, "required": ["from_account", "to_account", "amount", "currency", "memo"]}}}, {"type": "function", "function": {"name": "get_balance", "description": "Read an account balance", "parameters": {"type": "object", "properties": {"account": {"type": "string"}}, "required": ["account"]}}}], "check": {"type": "tool_call", "name": "transfer_funds", "args": {"from_account": "ACC-1001", "to_account": "ACC-2002", "amount": 250, "currency": "USD", "memo": "rent"}}}
{"id": "tool-search", "category": "tool", "prompt": "Find me open issues labelled bug in the repo simonw/pelican-bicycle, newest first, at most 5.", "tools": [{"type": "function", "function": {"name": "search_issues", "description": "Search GitHub issues", "parameters": {"type": "object", "properties": {"repo": {"type": "string"}, "state": {"type": "string", "enum": ["open", "closed", "all"]}, "label": {"type": "string"}, "sort": {"type": "string", "enum": ["newest", "oldest"]}, "limit": {"type": "integer"}}, "required": ["repo", "state", "label", "sort", "limit"]}}}], "check": {"type": "tool_call", "name": "search_issues", "args": {"repo": "simonw/pelican-bicycle", "state": "open", "label": "bug", "sort": "newest", "limit": 5}}}

# ---- zhtw: Traditional Chinese translation; fails on dropped terms or simplified-character leakage
{"id": "zhtw-rates", "category": "zhtw", "prompt": "Translate the following into Traditional Chinese as used in Taiwan. Output only the translation.\n\nThe central bank left the benchmark interest rate unchanged on Thursday, citing stable inflation and a resilient labour market. Analysts expect the first rate cut in the second quarter of next year.", "check": {"type": "zhtw", "required_any": [["央行", "中央銀行"], ["利率"], ["通膨", "通貨膨脹"], ["勞動", "就業", "勞工"], ["第二季", "二季"]]}}
{"id": "zhtw-tech", "category": "zhtw", "prompt": "Translate the following into Traditional Chinese as used in Taiwan. Output only the translation.\n\nThe update reduces memory usage on laptops with 16 GB of video memory and adds support for speculative decoding. Users should back up their configuration file before upgrading.", "check": {"type": "zhtw", "required_any": [["記憶體"], ["筆記型電腦", "筆電"], ["推測", "投機", "預測"], ["備份"], ["設定檔", "組態檔", "配置檔"]]}}
{"id": "zhtw-health", "category": "zhtw", "prompt": "Translate the following into Traditional Chinese as used in Taiwan. Output only the translation.\n\nThe hospital opened a new outpatient clinic for diabetes patients. Appointments can be booked online or by telephone, and the first visit includes a blood test.", "check": {"type": "zhtw", "required_any": [["醫院"], ["門診"], ["糖尿病"], ["預約", "掛號"], ["血液檢查", "抽血", "驗血"]]}}

# ---- effort: same puzzle at low/medium/high; the runner reports answer flips and reasoning length per effort
{"id": "effort-ages", "category": "effort", "prompt": "Ann is twice as old as Ben was when Ann was as old as Ben is now. Ann is 24. How old is Ben? Reply with only the number.", "check": {"type": "last_int", "expected": 18}}
{"id": "effort-handshake", "category": "effort", "prompt": "At a meeting of 14 people, everyone shakes hands with everyone else exactly once. How many handshakes occur? Reply with only the number.", "check": {"type": "last_int", "expected": 91}}
{"id": "effort-trains", "category": "effort", "prompt": "Two trains are 420 km apart and travel toward each other, one at 70 km/h and the other at 50 km/h. A bird flies back and forth between them at 90 km/h until they meet. How many km does the bird fly? Reply with only the number.", "check": {"type": "last_int", "expected": 315}}
{"id": "effort-digits", "category": "effort", "prompt": "How many three-digit positive integers have digits that sum to exactly 5? Reply with only the number.", "check": {"type": "last_int", "expected": 15}}
{"id": "effort-remainder", "category": "effort", "prompt": "What is the remainder when 7^100 is divided by 13? Reply with only the number.", "check": {"type": "last_int", "expected": 9}}

# ---- code: executed only with --run-code (limited subprocess). Prompt asks for a bare function in one fence.
{"id": "code-rle", "category": "code", "prompt": "Write a Python function rle(s: str) -> str that run-length encodes a string: 'aaabccdddd' -> 'a3b1c2d4', '' -> ''. Output only the function in a single ```python code fence, no tests, no prints.", "check": {"type": "code", "tests": ["assert rle('aaabccdddd') == 'a3b1c2d4'", "assert rle('') == ''", "assert rle('x') == 'x1'", "assert rle('aabbaa') == 'a2b2a2'"]}}
{"id": "code-balanced", "category": "code", "prompt": "Write a Python function balanced(s: str) -> bool that returns True when the brackets ()[]{} in s are balanced and properly nested, ignoring other characters. Output only the function in a single ```python code fence.", "check": {"type": "code", "tests": ["assert balanced('(a[b]{c})')", "assert not balanced('(]')", "assert balanced('')", "assert not balanced('((')", "assert not balanced('{[}]')"]}}
{"id": "code-roman", "category": "code", "prompt": "Write a Python function to_roman(n: int) -> str for 1 <= n <= 3999. Output only the function in a single ```python code fence.", "check": {"type": "code", "tests": ["assert to_roman(1) == 'I'", "assert to_roman(4) == 'IV'", "assert to_roman(1994) == 'MCMXCIV'", "assert to_roman(3999) == 'MMMCMXCIX'", "assert to_roman(58) == 'LVIII'"]}}
{"id": "code-merge", "category": "code", "prompt": "Write a Python function merge_intervals(iv: list[list[int]]) -> list[list[int]] that merges overlapping closed intervals and returns them sorted by start. Output only the function in a single ```python code fence.", "check": {"type": "code", "tests": ["assert merge_intervals([[1,3],[2,6],[8,10],[15,18]]) == [[1,6],[8,10],[15,18]]", "assert merge_intervals([[1,4],[4,5]]) == [[1,5]]", "assert merge_intervals([]) == []", "assert merge_intervals([[5,6],[1,2]]) == [[1,2],[5,6]]"]}}
{"id": "code-anagram", "category": "code", "prompt": "Write a Python function group_anagrams(words: list[str]) -> list[list[str]] that groups anagrams together; each group keeps input order and groups are ordered by first appearance. Output only the function in a single ```python code fence.", "check": {"type": "code", "tests": ["assert group_anagrams(['eat','tea','tan','ate','nat','bat']) == [['eat','tea','ate'],['tan','nat'],['bat']]", "assert group_anagrams([]) == []", "assert group_anagrams(['a']) == [['a']]"]}}
{"id": "code-lru", "category": "code", "prompt": "Write a Python class LRU with __init__(self, cap: int), get(self, k) -> value or -1, and put(self, k, v); evict the least recently used key when over capacity; get counts as use. Output only the class in a single ```python code fence.", "check": {"type": "code", "tests": ["c = LRU(2); c.put(1,1); c.put(2,2); assert c.get(1) == 1", "c.put(3,3); assert c.get(2) == -1", "c.put(4,4); assert c.get(1) == -1 and c.get(3) == 3 and c.get(4) == 4"]}}
{"id": "code-binsearch", "category": "code", "prompt": "Write a Python function lower_bound(a: list[int], x: int) -> int returning the index of the first element >= x in sorted list a, or len(a) if none. Use binary search. Output only the function in a single ```python code fence.", "check": {"type": "code", "tests": ["assert lower_bound([1,3,3,5], 3) == 1", "assert lower_bound([1,3,3,5], 4) == 3", "assert lower_bound([1,3,3,5], 6) == 4", "assert lower_bound([], 1) == 0", "assert lower_bound([2], 1) == 0"]}}
{"id": "code-wordfreq", "category": "code", "prompt": "Write a Python function top_words(text: str, k: int) -> list[tuple[str, int]] returning the k most frequent lowercase words (letters only, split on non-letters), ties broken alphabetically. Output only the function in a single ```python code fence.", "check": {"type": "code", "tests": ["assert top_words('The cat and the hat. The CAT!', 2) == [('the', 3), ('cat', 2)]", "assert top_words('b a b a c', 3) == [('a', 2), ('b', 2), ('c', 1)]", "assert top_words('', 1) == []"]}}
{"id": "code-matrix", "category": "code", "prompt": "Write a Python function rotate(m: list[list[int]]) -> list[list[int]] that returns a square matrix rotated 90 degrees clockwise without modifying the input. Output only the function in a single ```python code fence.", "check": {"type": "code", "tests": ["m = [[1,2],[3,4]]; assert rotate(m) == [[3,1],[4,2]] and m == [[1,2],[3,4]]", "assert rotate([[1,2,3],[4,5,6],[7,8,9]]) == [[7,4,1],[8,5,2],[9,6,3]]", "assert rotate([[1]]) == [[1]]"]}}
{"id": "code-parse", "category": "code", "prompt": "Write a Python function parse_kv(s: str) -> dict[str, str] that parses 'a=1;b=hello world;c=' into {'a':'1','b':'hello world','c':''}, trimming whitespace around keys and values, ignoring empty segments, and raising ValueError on a segment without '='. Output only the function in a single ```python code fence.", "check": {"type": "code", "tests": ["assert parse_kv('a=1;b=hello world;c=') == {'a':'1','b':'hello world','c':''}", "assert parse_kv(' x = 2 ;; y=3 ') == {'x':'2','y':'3'}", "assert parse_kv('') == {}", "try:\n    parse_kv('oops')\n    raise SystemExit('expected ValueError')\nexcept ValueError:\n    pass"]}}
